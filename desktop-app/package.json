{
  "name": "team-board",
  "productName": "Team Board",
  "version": "1.0.0",
  "description": "Team board and DroneForge Pro ERP in one program",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:web": "sh ../team-board/build.sh && node build-web.js",
    "serve": "node server/index.js --data ./data --port 8080",
    "start": "electron .",
    "dist:win": "npm run build:web && electron-packager . \"Team Board\" --platform=win32 --arch=x64 --out=dist --overwrite --asar --prune=true --ignore=\"^/(dist|data|erp-source|web-src|build-web\\.js|test)($|/)\""
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "chart.js": "3.9.1",
    "electron": "33.2.1"
  }
}
